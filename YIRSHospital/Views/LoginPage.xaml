<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:renderers="clr-namespace:YIRSHospital.Services"
             x:Class="YIRSHospital.Views.LoginPage"
             BackgroundColor="#004225"
               xmlns:android="clr-namespace:Xamarin.Forms.PlatformConfiguration.AndroidSpecific;assembly=Xamarin.Forms.Core"
             android:Application.WindowSoftInputModeAdjust="Resize"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>

            <Color x:Key="DeepGreen">#001a0f</Color>
            <Color x:Key="RichGreen">#003d1f</Color>
            <Color x:Key="AccentGreen">#00ff88</Color>
            <Color x:Key="NeonGreen">#39ff14</Color>
            <Color x:Key="TextPrimary">#ffffff</Color>
            <Color x:Key="TextSecondary">#a0ffd6</Color>
            <Color x:Key="GlassWhite">#1affffff</Color>
            <Color x:Key="GlassBorder">white</Color>

            <!-- Sophisticated Styles -->
            <Style x:Key="GlassmorphicCard" TargetType="yummy:PancakeView">
                <Setter Property="HasShadow" Value="True"/>
                <Setter Property="Elevation" Value="30"/>
                <Setter Property="CornerRadius" Value="24"/>
                <Setter Property="BorderColor" Value="{StaticResource GlassBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <!-- ── Palette ─────────────────────────────────────────────── -->
            <Color x:Key="Brand">#004225</Color>
            <Color x:Key="BrandTint">#1A5138</Color>
            <Color x:Key="Canvas">#F1F1EE</Color>
            <Color x:Key="Card">#FFFFFF</Color>
            <Color x:Key="TextDark">#16211C</Color>
            <Color x:Key="TextMuted">#6B7770</Color>
            <Color x:Key="TextFaint">#8A938C</Color>
            <Color x:Key="OnBrand">#FFFFFF</Color>
            <Color x:Key="OnBrandMuted">#A9C4B6</Color>
            <Color x:Key="FieldBorder">#DDE1DC</Color>
            <Color x:Key="Hairline">#EAECE8</Color>
            <Color x:Key="MintText">#0F6E56</Color>
            <Color x:Key="DangerText">#A32D2D</Color>

            <!-- ── Type ───────────────────────────────────────────────── -->
            <Style x:Key="FieldLabel" TargetType="Label">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="TextColor" Value="{StaticResource TextMuted}"/>
                <Setter Property="Margin" Value="2,0,0,7"/>
            </Style>

            <Style x:Key="ValidationLabel" TargetType="Label">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="TextColor" Value="{StaticResource DangerText}"/>
                <Setter Property="IsVisible" Value="False"/>
                <Setter Property="Margin" Value="2,6,0,0"/>
            </Style>

            <!-- ── Field surfaces ─────────────────────────────────────── -->
            <Style x:Key="FieldShell" TargetType="yummy:PancakeView">
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="HeightRequest" Value="52"/>
                <Setter Property="BackgroundColor" Value="{StaticResource Card}"/>
                <Setter Property="BorderColor" Value="{StaticResource FieldBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <Style x:Key="FieldEntry" TargetType="renderers:BorderlessEntry">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="TextColor" Value="{StaticResource TextDark}"/>
                <Setter Property="PlaceholderColor" Value="{StaticResource TextFaint}"/>
                <Setter Property="BackgroundColor" Value="Transparent"/>
                <Setter Property="VerticalOptions" Value="Center"/>
            </Style>

        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <StackLayout Spacing="0">

            <!-- ═════════════════ HEADER ═════════════════
                 The institution is the trust signal here, not the product
                 name — an agent needs to recognise the body they collect for.
                 ══════════════════════════════════════════ -->
            <yummy:PancakeView x:Name="HeaderSection"
                               BackgroundColor="{StaticResource Brand}"
                               CornerRadius="0,0,26,26"
                               Padding="24,56,24,44">
                <StackLayout Spacing="0" HorizontalOptions="Center">

                    <yummy:PancakeView WidthRequest="66"
                                       HeightRequest="66"
                                       CornerRadius="20"
                                       BackgroundColor="{StaticResource Card}"
                                       HorizontalOptions="Center">
                        <Image Source="Yobe.png"
                               Aspect="AspectFit"
                               Margin="12"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </yummy:PancakeView>

                    <Label Text="Hospital collections"
                           TextColor="{StaticResource OnBrand}"
                           FontSize="20"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           Margin="0,14,0,0"/>

                    <Label Text="Yobe State Hospitals Management Board"
                           TextColor="{StaticResource OnBrandMuted}"
                           FontSize="12"
                           HorizontalTextAlignment="Center"
                           Margin="0,4,0,0"/>
                </StackLayout>
            </yummy:PancakeView>

            <!-- ═════════════════ FORM ═════════════════ -->
            <yummy:PancakeView x:Name="FormCard"
                               BackgroundColor="{StaticResource Brand}"
                               CornerRadius="18"
                               Margin="18,-24,18,0"
                               Padding="18,20"
                              >
                <StackLayout Spacing="0">

                    <!-- ── Hospital ──────────────────────────────────────
                         First and most prominent: it's the only choice on
                         this screen that outlives the session. Everything
                         downstream — departments, revenue head, receipt
                         logo — is scoped by it.
                         ─────────────────────────────────────────────── -->
                    <!-- ── Role Selection ── -->
       
                    <!-- ── Email ───────────────────────────────────────── -->
                    <StackLayout x:Name="EmailSection" Spacing="0" Margin="0,18,0,0">

                        <Label Text="Email address" Style="{StaticResource FieldLabel}"      TextColor="White"  />

                        <yummy:PancakeView Style="{StaticResource FieldShell}">
                            <renderers:BorderlessEntry x:Name="EmailEntry"
                                                       Style="{StaticResource FieldEntry}"
                                                       Placeholder="name@hospital.gov.ng"
                                                       Keyboard="Email"
                                                       Margin="14,0"
                                                       TextChanged="OnEmailTextChanged"/>
                        </yummy:PancakeView>

                        <Label x:Name="EmailValidationLabel"
                               Style="{StaticResource ValidationLabel}"/>
                    </StackLayout>

                    <!-- ── Password ────────────────────────────────────── -->
                    <StackLayout x:Name="PasswordSection" Spacing="0" Margin="0,18,0,0">

                        <Label Text="Password" Style="{StaticResource FieldLabel}"      TextColor="White" />

                        <yummy:PancakeView Style="{StaticResource FieldShell}">
                            <Grid ColumnDefinitions="*,Auto" Padding="14,0">

                                <renderers:BorderlessEntry Grid.Column="0"
                                                           x:Name="PasswordEntry"
                                                           Style="{StaticResource FieldEntry}"
                                                           Placeholder="Enter your password"
                                                           IsPassword="True"
                                                           TextChanged="OnPasswordTextChanged"/>

                                <!-- Named PasswordToggleButton so the existing
                                     code-behind keeps compiling. See the one-line
                                     patch to UpdatePasswordVisibility. -->
                                <Label Grid.Column="1"
                                       x:Name="PasswordToggleButton"
                                       Text="Show"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource MintText}"
                                       VerticalOptions="Center"
                                       Margin="10,0,0,0">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnPasswordToggleClicked"/>
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                        </yummy:PancakeView>

                        <Label x:Name="PasswordValidationLabel"
                               Style="{StaticResource ValidationLabel}"/>
                    </StackLayout>

                    <!-- ── Options ─────────────────────────────────────── -->
                    <Grid x:Name="OptionsRow"
                          ColumnDefinitions="Auto,*"
                          Margin="0,16,0,0"
                          VerticalOptions="Center">

                        <StackLayout Grid.Column="0"
                                     Orientation="Horizontal"
                                     Spacing="2"
                                     VerticalOptions="Center">
                            <CheckBox x:Name="RememberMeCheckbox"
                                      Color="#009955"
                                      VerticalOptions="Center"/>
                            <Label Text="Remember me"
                                   FontSize="13"
                                   TextColor="White"
                                   VerticalOptions="Center"/>
                        </StackLayout>

                        <Label Grid.Column="1"
                               Text="Forgot password"
                               FontSize="13"
                               TextColor="#009955"
                               HorizontalTextAlignment="End"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnForgotPasswordTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <!-- ── Sign in ─────────────────────────────────────── -->
                    <yummy:PancakeView x:Name="LoginButton"
                                      
                                       CornerRadius="12"
                                       HeightRequest="52"
                                       Margin="0,20,0,0">
                        <yummy:PancakeView.BackgroundGradientStops>
                            <yummy:GradientStopCollection>
                                <yummy:GradientStop Color="#00ff88" Offset="0"/>
                                <yummy:GradientStop Color="#00cc6a" Offset="0.5"/>
                                <yummy:GradientStop Color="#009955" Offset="1"/>
                            </yummy:GradientStopCollection>
                        </yummy:PancakeView.BackgroundGradientStops>
                        <Grid>
                            <Label x:Name="LoginButtonText"
                                   Text="Sign in"
                                   TextColor="{StaticResource OnBrand}"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>

                            <ActivityIndicator x:Name="LoginActivityIndicator"
                                               IsVisible="False"
                                               IsRunning="False"
                                               Color="{StaticResource OnBrand}"
                                               WidthRequest="24"
                                               HeightRequest="24"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>
                        </Grid>
                        <yummy:PancakeView.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLoginTapped"/>
                        </yummy:PancakeView.GestureRecognizers>
                    </yummy:PancakeView>

                    <!-- Stated at the point of credential entry, not buried
                         behind a policy link. -->
                    <Label Text="Encrypted connection to yobe.osoftpay.net"
                           FontSize="11"
                              TextColor="White"
                           HorizontalTextAlignment="Center"
                           Margin="0,14,0,0"/>
                </StackLayout>
            </yummy:PancakeView>

            <!-- ═════════════════ FOOTER ═════════════════ -->
            <StackLayout x:Name="FooterSection"
                         Spacing="3"
                         Padding="24,22,24,32">

                <BoxView HeightRequest="1"
                         Color="{StaticResource Hairline}"
                         Margin="0,0,0,14"/>

                <Label Text="Need help"
                       FontSize="12"
                       TextColor="White"
                       HorizontalTextAlignment="Center"/>

                <Label Text="08132849470 · 07036550295"
                       FontSize="12"
                       TextColor="WhiteSmoke"
                       HorizontalTextAlignment="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSupportContactTapped"/>
                    </Label.GestureRecognizers>
                </Label>

                <Label Text="Version 2.0.0"
                       FontSize="11"
                       TextColor="{StaticResource TextFaint}"
                       HorizontalTextAlignment="Center"
                       Margin="0,8,0,0"/>
            </StackLayout>
        </StackLayout>
    </ScrollView>
</ContentPage>
