<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView" xmlns:renderers="clr-namespace:YIRSHospital.Services"
             x:Class="YIRSHospital.Views.ProcessPatientBill"
             BackgroundColor="#F4F6F8">


    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="Primary">#004225</Color>
            <Color x:Key="PrimaryLight">#006B3C</Color>
            <Color x:Key="Accent">#FF6B35</Color>
            <Color x:Key="TextPrimary">#1A202C</Color>
            <Color x:Key="TextSecondary">#718096</Color>
            <Color x:Key="Border">#E2E8F0</Color>

            <!-- This missing style caused the crash -->
            <Style x:Key="FieldLabel" TargetType="Label">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
                <Setter Property="Margin" Value="2,0,0,6"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <RefreshView x:Name="PageRefreshView" Refreshing="OnRefreshRequested">
        <ScrollView>
            <StackLayout Spacing="16" Padding="16">

                <!-- ── Search & Fetch Card ── -->
                <yummy:PancakeView BackgroundColor="White" CornerRadius="14" Padding="16" HasShadow="True">
                    <StackLayout Spacing="12">
                        <StackLayout Spacing="2">
                            <Label Text="Fetch Pending Bill" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                            <Label Text="Enter patient number to retrieve cashier bill" FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                        </StackLayout>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <yummy:PancakeView Grid.Column="0" BorderColor="White" BorderThickness="1" CornerRadius="10" BackgroundColor="#F9FAFB" HeightRequest="48">
                                <renderers:BorderlessEntry x:Name="PatientSearchEntry" Placeholder="e.g. 0584" Margin="12,0" VerticalOptions="Center" TextColor="{StaticResource TextPrimary}" ReturnType="Search" Completed="OnFetchBillClicked"/>
                            </yummy:PancakeView>

                            <Button Grid.Column="1" Text="FETCH" BackgroundColor="{StaticResource Primary}" TextColor="White" FontAttributes="Bold" CornerRadius="10" HeightRequest="48" WidthRequest="90" Clicked="OnFetchBillClicked"/>
                        </Grid>

                        <!-- Recent searches -->
                        <CollectionView x:Name="RecentSearchesView"
                                        HeightRequest="42"
                                        SelectionMode="Single"
                                        SelectionChanged="OnRecentSearchSelected"
                                        IsVisible="False">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8"/>
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <yummy:PancakeView BackgroundColor="#EEF2FF" CornerRadius="16" Padding="12,8">
                                        <Label Text="{Binding}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Primary}" VerticalOptions="Center"/>
                                    </yummy:PancakeView>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </StackLayout>
                </yummy:PancakeView>

                <!-- ── Idle state ── -->
                <yummy:PancakeView x:Name="IdleStateCard" BackgroundColor="White" CornerRadius="12" Padding="28" HasShadow="False">
                    <StackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="🧾" FontSize="34" HorizontalOptions="Center"/>
                        <Label Text="No bill loaded" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center"/>
                        <Label Text="Fetch a patient's pending bill above to begin processing payment." FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                    </StackLayout>
                </yummy:PancakeView>

                <!-- ── Not found state ── -->
                <yummy:PancakeView x:Name="NotFoundCard" BackgroundColor="#FFFBEB" BorderColor="#FDE68A" BorderThickness="1" CornerRadius="12" Padding="20" HasShadow="False" IsVisible="False">
                    <StackLayout Spacing="6" HorizontalOptions="Center">
                        <Label Text="🗂️" FontSize="30" HorizontalOptions="Center"/>
                        <Label Text="No pending bill found" FontSize="15" FontAttributes="Bold" TextColor="#92400E" HorizontalOptions="Center"/>
                        <Label x:Name="NotFoundMessageLabel" FontSize="12" TextColor="#92400E" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                    </StackLayout>
                </yummy:PancakeView>

                <!-- ── Bill Details Card (Shown after fetch) ── -->
                <yummy:PancakeView x:Name="BillDetailsCard" BackgroundColor="White" CornerRadius="14" Padding="16" HasShadow="True" IsVisible="False">
                    <StackLayout Spacing="14">

                        <!-- Header Info -->
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="6">
                            <Label Grid.Row="0" Grid.Column="0" Text="Patient Name:" TextColor="{StaticResource TextSecondary}" FontSize="13"/>
                            <Label Grid.Row="0" Grid.Column="1" x:Name="PatientNameLabel" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" FontSize="13"/>

                            <Label Grid.Row="1" Grid.Column="0" Text="Gender:" TextColor="{StaticResource TextSecondary}" FontSize="13"/>
                            <Label Grid.Row="1" Grid.Column="1" x:Name="GenderLabel" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" FontSize="13"/>

                            <Label Grid.Row="2" Grid.Column="0" Text="Department:" TextColor="{StaticResource TextSecondary}" FontSize="13"/>
                            <Label Grid.Row="2" Grid.Column="1" x:Name="DepartmentLabel" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" FontSize="13"/>

                            <Label Grid.Row="3" Grid.Column="0" Text="Bill Group ID:" TextColor="{StaticResource TextSecondary}" FontSize="13"/>
                            <Label Grid.Row="3" Grid.Column="1" x:Name="BillGroupIdLabel" FontAttributes="Bold" TextColor="{StaticResource Primary}" FontSize="13"/>
                        </Grid>

                        <!-- Tappable phone row -->
                        <Grid x:Name="PhoneRow" ColumnDefinitions="*,Auto" IsVisible="False">
                            <Label Grid.Column="0" Text="Phone Number:" TextColor="{StaticResource TextSecondary}" FontSize="13" VerticalOptions="Center"/>
                            <StackLayout Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <Label x:Name="PhoneNumberLabel" FontAttributes="Bold" TextColor="{StaticResource Primary}" FontSize="13" VerticalOptions="Center"/>
                                <Label Text="📞" FontSize="14" VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCallPatientTapped"/>
                                    </Label.GestureRecognizers>
                                </Label>
                            </StackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="WhiteSmoke"/>

                        <!-- Itemized Services -->
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Pending Services" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                            <Label Grid.Column="1" x:Name="ServiceCountLabel" FontSize="12" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                        </Grid>
                        <CollectionView x:Name="PendingServicesCollection" HeightRequest="180" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" Padding="0,6">
                                        <StackLayout Grid.Column="0" Spacing="2">
                                            <StackLayout Orientation="Horizontal" Spacing="6">
                                                <Label Text="{Binding ServiceName}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                                                <yummy:PancakeView BackgroundColor="#EEF2FF" CornerRadius="8" Padding="6,2" IsVisible="{Binding HasStatus}">
                                                    <Label Text="{Binding StatusText}" FontSize="9" TextColor="{StaticResource Primary}"/>
                                                </yummy:PancakeView>
                                            </StackLayout>
                                            <Label Text="{Binding NotesText}" FontSize="11" TextColor="{StaticResource TextSecondary}" IsVisible="{Binding HasNotes}"/>
                                            <Label Text="{Binding RaisedByText}" FontSize="10" TextColor="{StaticResource TextSecondary}" IsVisible="{Binding HasRaisedBy}"/>
                                        </StackLayout>
                                        <Label Grid.Column="1" Text="{Binding Amount, StringFormat='₦{0:N2}'}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <!-- Total Banner -->
                        <yummy:PancakeView BackgroundGradientStartColor="{StaticResource Primary}"
                                           BackgroundGradientEndColor="{StaticResource PrimaryLight}"
                                           BackgroundGradientAngle="90"
                                           CornerRadius="10"
                                           Padding="14">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Grand Total" TextColor="White" FontSize="14" FontAttributes="Bold" VerticalOptions="Center"/>
                                <Label Grid.Column="1" x:Name="GrandTotalLabel" TextColor="White" FontSize="20" FontAttributes="Bold" VerticalOptions="Center"/>
                            </Grid>
                        </yummy:PancakeView>

                        <!-- ── Payment Method ── -->
                        <Label Text="Select Payment Method" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" Margin="0,6,0,0"/>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <Button x:Name="CashBtn" Grid.Column="0" Text=" Cash" BackgroundColor="{StaticResource Primary}" TextColor="White" CornerRadius="8" HeightRequest="40" Clicked="OnCashSelected"/>
                            <Button x:Name="TransferBtn" Grid.Column="1" Text="Transfer" BackgroundColor="#E2E8F0" TextColor="{StaticResource TextPrimary}" CornerRadius="8" HeightRequest="40" Clicked="OnTransferSelected"/>
                            <Button x:Name="CardBtn" Grid.Column="2" Text="Card" BackgroundColor="#E2E8F0" TextColor="{StaticResource TextPrimary}" CornerRadius="8" HeightRequest="40" Clicked="OnCardSelected"/>
                        </Grid>

                        <!-- Reference Input (For Transfer/Card) -->
                        <StackLayout x:Name="ReferenceSection" Spacing="4" IsVisible="False">
                            <Label Text="Payment Reference" />
                            <yummy:PancakeView BorderColor="WhiteSmoke" BorderThickness="1" CornerRadius="10" BackgroundColor="#F9FAFB" HeightRequest="44">
                                <renderers:BorderlessEntry x:Name="ReferenceEntry" Placeholder="Bank transaction reference" Margin="12,0" VerticalOptions="Center" TextColor="{StaticResource TextPrimary}"/>
                            </yummy:PancakeView>
                        </StackLayout>

                        <!-- Agent PIN -->
                        <StackLayout Spacing="4">
                            <Label Text="Wallet PIN" />
                            <Grid ColumnDefinitions="*,Auto">
                                <yummy:PancakeView Grid.Column="0" BorderColor="WhiteSmoke" BorderThickness="1" CornerRadius="10" BackgroundColor="#F9FAFB" HeightRequest="44">
                                    <renderers:BorderlessEntry x:Name="PinEntry" Placeholder="Enter 4-digit PIN" IsPassword="True" MaxLength="4" FontSize="12" Keyboard="Numeric" Margin="12,0" VerticalOptions="Center" TextColor="{StaticResource TextPrimary}"/>
                                </yummy:PancakeView>
                                <Button Grid.Column="1" x:Name="TogglePinVisibilityButton" Text="👁" WidthRequest="44" HeightRequest="44" Margin="8,0,0,0" BackgroundColor="#E2E8F0" CornerRadius="10" Clicked="OnTogglePinVisibilityClicked"/>
                            </Grid>
                        </StackLayout>

                        <!-- Process Payment Action -->
                        <Button x:Name="CompletePaymentButton" Text="COMPLETE PAYMENT" BackgroundColor="OrangeRed" TextColor="White" FontAttributes="Bold" CornerRadius="10" HeightRequest="50" Margin="0,8,0,0" Clicked="OnProcessPaymentClicked"/>
                    </StackLayout>
                </yummy:PancakeView>

                <!-- ── Payment Result Card ── -->
                <yummy:PancakeView x:Name="ResultCard" BackgroundColor="White" CornerRadius="16" Padding="20" HasShadow="True" IsVisible="False">
                    <StackLayout Spacing="12">
                        <StackLayout Orientation="Horizontal" Spacing="10">
                            <Label Text="✅" FontSize="26" VerticalOptions="Center"/>
                            <StackLayout Spacing="0" VerticalOptions="Center">
                                <Label Text="Payment successful" FontSize="15" FontAttributes="Bold" TextColor="#166534"/>
                                <Label x:Name="ResultSubtitleLabel" FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                            </StackLayout>
                        </StackLayout>

                        <BoxView HeightRequest="1" BackgroundColor="#E2E8F0"/>

                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="10">
                            <StackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                <Label Text="Transaction No" FontSize="11" TextColor="{StaticResource TextSecondary}"/>
                                <Label x:Name="TransactionNoLabel" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                            </StackLayout>
                            <Button Grid.Row="0" Grid.Column="1" Text="Copy" FontSize="11" Padding="10,4" BackgroundColor="#E2E8F0" TextColor="{StaticResource TextPrimary}" CornerRadius="8" Clicked="OnCopyTransactionNoClicked"/>

                            <StackLayout Grid.Row="1" Grid.Column="0" Spacing="2">
                                <Label Text="Debit Reference" FontSize="11" TextColor="{StaticResource TextSecondary}"/>
                                <Label x:Name="DebitRefResultLabel" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                            </StackLayout>
                            <Button Grid.Row="1" Grid.Column="1" Text="Copy" FontSize="11" Padding="10,4" BackgroundColor="#E2E8F0" TextColor="{StaticResource TextPrimary}" CornerRadius="8" Clicked="OnCopyDebitRefClicked"/>
                        </Grid>

                        <Label Text="Amount Paid" FontSize="11" TextColor="{StaticResource TextSecondary}"/>
                        <Label x:Name="ResultTotalAmountLabel" FontSize="20" FontAttributes="Bold" TextColor="#10B981"/>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Grid.Column="0" Text="📤 Share" FontSize="13" BackgroundColor="#EEF2FF" TextColor="{StaticResource Primary}" CornerRadius="10" Clicked="OnShareResultClicked"/>
                            <Button Grid.Column="1" Text="Done" FontSize="13" BackgroundColor="{StaticResource Primary}" TextColor="White" CornerRadius="10" Clicked="OnDoneClicked"/>
                        </Grid>
                    </StackLayout>
                </yummy:PancakeView>

            </StackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
