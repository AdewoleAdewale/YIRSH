<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             x:Class="YIRSHospital.Views.Dashboard"
             Padding="0"
             BackgroundColor="#F1F1EE"
             NavigationPage.HasNavigationBar="False"
               xmlns:android="clr-namespace:Xamarin.Forms.PlatformConfiguration.AndroidSpecific;assembly=Xamarin.Forms.Core"
             android:Application.WindowSoftInputModeAdjust="Resize"
             x:Name="DashboardPage">

    <ContentPage.Resources>
        <ResourceDictionary>

            <!-- ── Palette ─────────────────────────────────────────────── -->
            <Color x:Key="Brand">#004225</Color>
            <Color x:Key="BrandDeep">#00311B</Color>
            <Color x:Key="Canvas">#F1F1EE</Color>
            <Color x:Key="Card">#FFFFFF</Color>
            <Color x:Key="TextDark">#16211C</Color>
            <Color x:Key="TextMuted">#6B7770</Color>
            <Color x:Key="OnBrand">#FFFFFF</Color>
            <Color x:Key="OnBrandMuted">#A9C4B6</Color>
            <Color x:Key="Hairline">#E3E5E0</Color>
            <Color x:Key="MintFill">#E1F5EE</Color>
            <Color x:Key="MintText">#0F6E56</Color>
            <Color x:Key="AmberFill">#FAEEDA</Color>
            <Color x:Key="AmberText">#854F0B</Color>
            <Color x:Key="RedFill">#FCEBEB</Color>
            <Color x:Key="RedText">#A32D2D</Color>

            <!-- ── Type ramp ───────────────────────────────────────────── -->
            <Style x:Key="Overline" TargetType="Label">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="TextColor" Value="{StaticResource OnBrandMuted}"/>
            </Style>

            <Style x:Key="TileCaption" TargetType="Label">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="TextColor" Value="{StaticResource TextDark}"/>
                <Setter Property="HorizontalTextAlignment" Value="Center"/>
                <Setter Property="LineBreakMode" Value="TailTruncation"/>
            </Style>

            <Style x:Key="StatValue" TargetType="Label">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="{StaticResource OnBrand}"/>
            </Style>

            <Style x:Key="StatLabel" TargetType="Label">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="TextColor" Value="{StaticResource OnBrandMuted}"/>
            </Style>

            <!-- ── Surfaces ────────────────────────────────────────────── -->
            <Style x:Key="StatTile" TargetType="yummy:PancakeView">
                <Setter Property="BackgroundColor" Value="#1A5138"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="10,8"/>
            </Style>

            <Style x:Key="QuickTile" TargetType="yummy:PancakeView">
                <Setter Property="BackgroundColor" Value="{StaticResource Card}"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="4,12"/>
                <Setter Property="BorderColor" Value="{StaticResource Hairline}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <Style x:Key="TileBadge" TargetType="yummy:PancakeView">
                <Setter Property="WidthRequest" Value="38"/>
                <Setter Property="HeightRequest" Value="38"/>
                <Setter Property="CornerRadius" Value="11"/>
                <Setter Property="HorizontalOptions" Value="Center"/>
            </Style>

            <Style x:Key="TileBadgeText" TargetType="Label">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="HorizontalOptions" Value="Center"/>
                <Setter Property="VerticalOptions" Value="Center"/>
            </Style>

        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowSpacing="0">

        <!-- =====================================================================
             ONE scroll surface. The green header, stats, actions and section
             title all live in CollectionView.Header, so there is no ScrollView
             wrapping a list and therefore no nested-scroll conflict.
             ===================================================================== -->
        <RefreshView IsRefreshing="{Binding IsRefreshing, Mode=TwoWay}"
             Command="{Binding RefreshCommand}"
             RefreshColor="{StaticResource Brand}">

            <CollectionView x:Name="ActivityCollectionView"
                    ItemsSource="{Binding RecentTransactions}"
                    BackgroundColor="Transparent"
                    SelectionMode="None"
                    ItemSizingStrategy="MeasureAllItems">

                <CollectionView.Header>
                    <StackLayout Spacing="0">

                        <yummy:PancakeView BackgroundColor="{StaticResource Brand}" CornerRadius="0,0,22,22" Padding="16,14,16,20">

                            <StackLayout Spacing="0">

                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <yummy:PancakeView Grid.Column="0"
                                               WidthRequest="40"
                                               HeightRequest="40"
                                               CornerRadius="13"
                                               BackgroundColor="#1A5138">
                                        <Label Text="{Binding AgentInitials}"
                                       TextColor="{StaticResource OnBrand}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                                    </yummy:PancakeView>

                                    <StackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                        <Label Text="{Binding Greeting}" Style="{StaticResource Overline}"/>
                                        <Label Text="{Binding AgentName}"
                                       TextColor="{StaticResource OnBrand}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       LineBreakMode="TailTruncation"/>
                                    </StackLayout>

                                    <yummy:PancakeView Grid.Column="2"
                                               WidthRequest="36" HeightRequest="36"
                                               CornerRadius="11"
                                               BackgroundColor="#1A5138"
                                               VerticalOptions="Center">
                                        <Label Text="•••"
                                       TextColor="{StaticResource OnBrand}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                                        <yummy:PancakeView.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="Settings_Tapped"/>
                                        </yummy:PancakeView.GestureRecognizers>
                                    </yummy:PancakeView>

                                    <yummy:PancakeView Grid.Column="3"
                                               WidthRequest="36" HeightRequest="36"
                                               CornerRadius="11"
                                               BackgroundColor="#1A5138"
                                               VerticalOptions="Center">
                                        <Image Source="shutdown"
                                       Aspect="AspectFit"
                                       Margin="9"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                                        <yummy:PancakeView.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="Logout_Tapped"/>
                                        </yummy:PancakeView.GestureRecognizers>
                                    </yummy:PancakeView>
                                </Grid>

                                <yummy:PancakeView BackgroundColor="#1A5138"
                                           CornerRadius="11"
                                           Padding="11,9"
                                           HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand"
                                           Margin="0,14,0,0">
                                    <Grid ColumnSpacing="9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <BoxView Grid.Column="0"
                                         WidthRequest="4"
                                         CornerRadius="2"
                                         BackgroundColor="OrangeRed"
                                         VerticalOptions="Fill"/>

                                        <StackLayout Grid.Column="1" Spacing="1" VerticalOptions="CenterAndExpand">
                                            <Label Text="{Binding HospitalName}"
                                           TextColor="{StaticResource OnBrand}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           LineBreakMode="TailTruncation"/>
                                            <Label Text="{Binding HospitalSubline}"
                                           Style="{StaticResource Overline}"
                                           LineBreakMode="TailTruncation"/>
                                        </StackLayout>
                                    </Grid>
                                    <yummy:PancakeView.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="HospitalChip_Tapped"/>
                                    </yummy:PancakeView.GestureRecognizers>
                                </yummy:PancakeView>

                                <StackLayout Spacing="1" Margin="0,16,0,0">
                                    <Label Text="Collected today" Style="{StaticResource Overline}"/>
                                    <Label Text="{Binding CollectedTodayText}"
                                   TextColor="{StaticResource OnBrand}"
                                   FontSize="30"
                                   FontAttributes="Bold"/>
                                    <Label Text="{Binding CollectedTodaySubline}"
                                   Style="{StaticResource Overline}"/>
                                </StackLayout>

                                <Grid Margin="0,14,0,0" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <yummy:PancakeView Grid.Column="0" Style="{StaticResource StatTile}">
                                        <StackLayout Spacing="0">
                                            <Label Text="{Binding PaymentCountText}" Style="{StaticResource StatValue}"/>
                                            <Label Text="Payments" Style="{StaticResource StatLabel}"/>
                                        </StackLayout>
                                    </yummy:PancakeView>

                                    <yummy:PancakeView Grid.Column="1" Style="{StaticResource StatTile}">
                                        <StackLayout Spacing="0">
                                            <Label Text="{Binding AverageTicketText}" Style="{StaticResource StatValue}"/>
                                            <Label Text="Avg ticket" Style="{StaticResource StatLabel}"/>
                                        </StackLayout>
                                    </yummy:PancakeView>

                                    <yummy:PancakeView Grid.Column="2" Style="{StaticResource StatTile}">
                                        <StackLayout Spacing="0">
                                            <Label Text="{Binding WeekTotalText}" Style="{StaticResource StatValue}"/>
                                            <Label Text="Last 7 days" Style="{StaticResource StatLabel}"/>
                                        </StackLayout>
                                    </yummy:PancakeView>
                                </Grid>
                            </StackLayout>
                        </yummy:PancakeView>

                        <StackLayout Orientation="Horizontal" Spacing="8" Padding="16,12,16,0">
                            <yummy:PancakeView CornerRadius="20" Padding="10,5" BackgroundColor="{Binding NetworkChipFill}">
                                <Label Text="{Binding NetworkChipText}" FontSize="11" TextColor="{Binding NetworkTextColor}"/>
                            </yummy:PancakeView>

                            <yummy:PancakeView CornerRadius="20" Padding="10,5" BackgroundColor="{Binding PrinterChipFill}">
                                <Label Text="{Binding PrinterChipText}" FontSize="11" TextColor="{Binding PrinterTextColor}"/>
                                <yummy:PancakeView.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="TestPrinter_Tapped"/>
                                </yummy:PancakeView.GestureRecognizers>
                            </yummy:PancakeView>
                        </StackLayout>

                        <yummy:PancakeView Margin="16,14,16,0"
                                   BackgroundColor="{StaticResource Brand}"
                                   CornerRadius="14"
                                   Padding="16,15"
                                   HasShadow="True"
                                   Elevation="6">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                    <Label Text="New payment" TextColor="{StaticResource OnBrand}" FontSize="16" FontAttributes="Bold"/>
                                    <Label Text="Register, select services, collect" Style="{StaticResource Overline}"/>
                                </StackLayout>

                                <Label Grid.Column="1" Text="→" TextColor="{StaticResource OnBrand}" FontSize="22" VerticalOptions="Center"/>
                            </Grid>
                            <yummy:PancakeView.GestureRecognizers>
                                <TapGestureRecognizer Tapped="NewPayment_Tapped"/>
                            </yummy:PancakeView.GestureRecognizers>
                        </yummy:PancakeView>

                        <Grid Margin="16,10,16,0" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <yummy:PancakeView Grid.Column="0" Style="{StaticResource QuickTile}">
                                <StackLayout Spacing="6">
                                    <yummy:PancakeView Style="{StaticResource TileBadge}" BackgroundColor="{StaticResource MintFill}">
                                        <Label Text="P" Style="{StaticResource TileBadgeText}" TextColor="{StaticResource MintText}"/>
                                    </yummy:PancakeView>
                                    <Label Text="Patients" Style="{StaticResource TileCaption}"/>
                                </StackLayout>
                                <yummy:PancakeView.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="PatientHistory_Tapped"/>
                                </yummy:PancakeView.GestureRecognizers>
                            </yummy:PancakeView>

                            <yummy:PancakeView Grid.Column="1" Style="{StaticResource QuickTile}">
                                <StackLayout Spacing="6">
                                    <yummy:PancakeView Style="{StaticResource TileBadge}" BackgroundColor="#E6F1FB">
                                        <Label Text="H" Style="{StaticResource TileBadgeText}" TextColor="#185FA5"/>
                                    </yummy:PancakeView>
                                    <Label Text="History" Style="{StaticResource TileCaption}"/>
                                </StackLayout>
                                <yummy:PancakeView.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="ViewAllTransactions_Clicked"/>
                                </yummy:PancakeView.GestureRecognizers>
                            </yummy:PancakeView>

                            <yummy:PancakeView Grid.Column="2" Style="{StaticResource QuickTile}">
                                <StackLayout Spacing="6">
                                    <yummy:PancakeView Style="{StaticResource TileBadge}" BackgroundColor="{StaticResource AmberFill}">
                                        <Label Text="T" Style="{StaticResource TileBadgeText}" TextColor="{StaticResource AmberText}"/>
                                    </yummy:PancakeView>
                                    <Label Text="Test print" Style="{StaticResource TileCaption}"/>
                                </StackLayout>
                                <yummy:PancakeView.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="TestPrinter_Tapped"/>
                                </yummy:PancakeView.GestureRecognizers>
                            </yummy:PancakeView>

                            <yummy:PancakeView Grid.Column="3" Style="{StaticResource QuickTile}">
                                <StackLayout Spacing="6">
                                    <yummy:PancakeView Style="{StaticResource TileBadge}" BackgroundColor="#EEEDFE">
                                        <Label Text="S" Style="{StaticResource TileBadgeText}" TextColor="#534AB7"/>
                                    </yummy:PancakeView>
                                    <Label Text="Settings" Style="{StaticResource TileCaption}"/>
                                </StackLayout>
                                <yummy:PancakeView.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="Settings_Tapped"/>
                                </yummy:PancakeView.GestureRecognizers>
                            </yummy:PancakeView>
                        </Grid>

                        <Grid Margin="16,20,16,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Label Grid.Column="0" Text="Recent activity" TextColor="{StaticResource TextDark}" FontSize="15" FontAttributes="Bold" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="See all" TextColor="{StaticResource MintText}" FontSize="12" VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="ViewAllTransactions_Clicked"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                    </StackLayout>
                </CollectionView.Header>

                <CollectionView.ItemTemplate >
                    <DataTemplate >
                        <StackLayout Spacing="5"    Margin="1,1,1,0">
                            <yummy:PancakeView BackgroundColor="{StaticResource Card}"
                 CornerRadius="16"
                         
                 BorderColor="{StaticResource Hairline}"
                 BorderThickness="1" Margin="10,0,10,5"
                 Padding="10,5,10,5"
                 HasShadow="True"
                 Elevation="2">
                                <Grid ColumnSpacing="15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <yummy:PancakeView Grid.Column="0"
                         WidthRequest="42"
                         HeightRequest="42"
                         CornerRadius="14"
                         BackgroundColor="{Binding BadgeFill}"
                         VerticalOptions="Center">
                                        <Label Text="{Binding Initials}"
                 TextColor="{Binding BadgeTextColor}"
                 FontSize="13"
                 FontAttributes="Bold"
                 HorizontalOptions="Center"
                 VerticalOptions="Center"/>
                                    </yummy:PancakeView>

                                    <StackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding PrimaryLine}"
                 TextColor="{StaticResource TextDark}"
                 FontSize="14"
                 FontAttributes="Bold"
                 LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding SecondaryLine}"
                 TextColor="{StaticResource TextMuted}"
                 FontSize="12"
                 LineBreakMode="TailTruncation"/>
                                    </StackLayout>

                                    <StackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center" HorizontalOptions="End">
                                        <Label Text="{Binding FormattedAmount}"
                 TextColor="{StaticResource TextDark}"
                 FontSize="14"
                 FontAttributes="Bold"
                 HorizontalTextAlignment="End"/>
                                        <Label Text="{Binding StatusDisplay}"
                 TextColor="{Binding StatusColor}"
                 FontSize="11"
                 FontAttributes="Bold"
                 HorizontalTextAlignment="End"/>
                                    </StackLayout>
                                </Grid>
                            </yummy:PancakeView>
                        </StackLayout>
                  
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <StackLayout Padding="32,24" Spacing="6">
                        <Label Text="{Binding EmptyTitle}" TextColor="{StaticResource TextDark}" FontSize="14" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                        <Label Text="{Binding EmptyBody}" TextColor="{StaticResource TextMuted}" FontSize="12" HorizontalTextAlignment="Center"/>
                    </StackLayout>
                </CollectionView.EmptyView>

                
                <CollectionView.Footer>
                    <BoxView HeightRequest="24" Color="Transparent"/>
                    
                </CollectionView.Footer>

        
            </CollectionView>

      
        </RefreshView>
        <!-- ───────────────────────── LOADING ───────────────────────── -->
        <ContentView x:Name="LoadingOverlay"
                     IsVisible="False"
                     BackgroundColor="#B3000000"
                     InputTransparent="False">
            <yummy:PancakeView BackgroundColor="{StaticResource Card}"
                               CornerRadius="16"
                               WidthRequest="190"
                               Padding="20"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               HasShadow="True"
                               Elevation="12">
                <StackLayout Spacing="14" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="True"
                                       Color="{StaticResource Brand}"
                                       WidthRequest="34"
                                       HeightRequest="34"/>
                    <Label x:Name="LoadingText"
                           Text="Loading…"
                           TextColor="{StaticResource TextDark}"
                           FontSize="13"
                           HorizontalTextAlignment="Center"/>
                </StackLayout>
            </yummy:PancakeView>
        </ContentView>
       

    </Grid>
</ContentPage>
