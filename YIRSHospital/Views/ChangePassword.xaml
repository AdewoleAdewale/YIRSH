<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView" xmlns:renderers="clr-namespace:YIRSHospital.Services"
             x:Class="YIRSHospital.Views.ChangePassword"             NavigationPage.HasNavigationBar="False"
             BackgroundColor="Transparent">

    <!-- Semi-transparent overlay -->
    <Grid x:Name="MainContainer">
        <BoxView BackgroundColor="Black" 
                 Opacity="0" 
                 x:Name="Overlay">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnOverlayTapped"/>
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- Bottom Sheet Container -->
        <yummy:PancakeView
            x:Name="BottomSheet"
            VerticalOptions="End"
            TranslationY="800"
            BackgroundColor="White"
            CornerRadius="30,30,0,0"
            Elevation="10"
            HasShadow="True">

            <Grid RowDefinitions="Auto,*" Padding="0">

                <!-- Drag Handle Area -->
                <StackLayout Grid.Row="0" 
                           Padding="0,15,0,10"
                           BackgroundColor="Transparent">
                    <BoxView BackgroundColor="#E0E0E0"
                           WidthRequest="50"
                           HeightRequest="5"
                           CornerRadius="2.5"
                           HorizontalOptions="Center"/>
                </StackLayout>

                <!-- Content Area with Scroll -->
                <ScrollView Grid.Row="1" 
                          HorizontalOptions="FillAndExpand" 
                          VerticalOptions="FillAndExpand">
                    <StackLayout Padding="30,10,30,40" Spacing="20">

                        <!-- Header with Icon -->
                        <StackLayout Spacing="15">
                            <yummy:PancakeView
                                BackgroundColor="#F0F9F5"
                                CornerRadius="30"
                                WidthRequest="60"
                                HeightRequest="60"
                                HorizontalOptions="Center">
                                <Label Text="🔒"
                                     FontSize="30"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center"/>
                            </yummy:PancakeView>

                            <Label Text="Change Password"
                                 FontAttributes="Bold"
                                 FontSize="24"
                                 TextColor="#004225"
                                 HorizontalTextAlignment="Center"/>
                        </StackLayout>

                        <!-- Security Notice -->
                        <yummy:PancakeView
                            BackgroundColor="#FFF3E0"
                            CornerRadius="12"
                            Padding="15"
                            HasShadow="False">
                            <StackLayout Orientation="Horizontal" Spacing="10">
                                <Label Text="ℹ️" 
                                     FontSize="18"
                                     VerticalOptions="Start"/>
                                <Label Text="Your new password must contain a capital letter, symbol, and be at least 8 characters long."
                                     TextColor="#E65100"
                                     FontSize="12"
                                     VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand"
                                     LineBreakMode="WordWrap"/>
                            </StackLayout>
                        </yummy:PancakeView>

                        <!-- Current Password Field -->
                        <StackLayout Spacing="8" x:Name="CurrentPasswordContainer">
                            <Label Text="Current Password"
                                 Margin="5,0,0,0"
                                 FontSize="14"
                                 FontAttributes="Bold"
                                 TextColor="#004225"/>
                            <yummy:PancakeView
                                Padding="15,0,15,0"
                                BackgroundColor="White"
                                BorderThickness="1.5"
                                BorderColor="#E0E0E0"
                                CornerRadius="12"
                                HeightRequest="55"
                                x:Name="CurrentPasswordBorder">
                                <Grid ColumnDefinitions="*,Auto">
                                    <renderers:BorderlessEntry
                                        Grid.Column="0"
                                        FontSize="14"
                                        IsPassword="True"
                                        Placeholder="Enter current password"
                                        TextColor="#484848"
                                        PlaceholderColor="#BDBDBD"
                                        VerticalOptions="Center"
                                        x:Name="OldPasswordEntry"/>
                                    <Label Grid.Column="1"
                                         Text="👁️"
                                         FontSize="18"
                                         VerticalOptions="Center"
                                         x:Name="CurrentPasswordToggle">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnToggleCurrentPassword"/>
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>
                            </yummy:PancakeView>
                        </StackLayout>

                        <!-- New Password Field -->
                        <StackLayout Spacing="8" x:Name="NewPasswordContainer">
                            <Label Text="New Password"
                                 Margin="5,0,0,0"
                                 FontSize="14"
                                 FontAttributes="Bold"
                                 TextColor="#004225"/>
                            <yummy:PancakeView
                                Padding="15,0,15,0"
                                BackgroundColor="White"
                                BorderThickness="1.5"
                                BorderColor="#E0E0E0"
                                CornerRadius="12"
                                HeightRequest="55"
                                x:Name="NewPasswordBorder">
                                <Grid ColumnDefinitions="*,Auto">
                                    <renderers:BorderlessEntry
                                        Grid.Column="0"
                                        FontSize="14"
                                        IsPassword="True"
                                        Placeholder="Enter new password"
                                        TextColor="#484848"
                                        PlaceholderColor="#BDBDBD"
                                        VerticalOptions="Center"
                                        x:Name="ConfirmPassword"/>
                                    <Label Grid.Column="1"
                                         Text="👁️"
                                         FontSize="18"
                                         VerticalOptions="Center"
                                         x:Name="NewPasswordToggle">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnToggleNewPassword"/>
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>
                            </yummy:PancakeView>
                        </StackLayout>

                        <!-- Password Strength Indicator -->
                        <StackLayout Spacing="5" x:Name="PasswordStrength" IsVisible="False">
                            <Label Text="Password Strength"
                                 FontSize="12"
                                 TextColor="#757575"
                                 Margin="5,0,0,0"/>
                            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="5">
                                <BoxView Grid.Column="0" HeightRequest="4" CornerRadius="2" BackgroundColor="#E0E0E0" x:Name="Strength1"/>
                                <BoxView Grid.Column="1" HeightRequest="4" CornerRadius="2" BackgroundColor="#E0E0E0" x:Name="Strength2"/>
                                <BoxView Grid.Column="2" HeightRequest="4" CornerRadius="2" BackgroundColor="#E0E0E0" x:Name="Strength3"/>
                                <BoxView Grid.Column="3" HeightRequest="4" CornerRadius="2" BackgroundColor="#E0E0E0" x:Name="Strength4"/>
                            </Grid>
                        </StackLayout>

                        <!-- Update Button -->
                        <yummy:PancakeView
                            BackgroundColor="#004225"
                            CornerRadius="12"
                            HeightRequest="56"
                            Margin="0,10,0,0"
                            HasShadow="True"
                            Elevation="5"
                            x:Name="UpdateButton">
                            <Label Text="Update Password"
                                 FontAttributes="Bold"
                                 FontSize="16"
                                 HorizontalOptions="Center"
                                 TextColor="White"
                                 VerticalOptions="Center"/>
                            <yummy:PancakeView.GestureRecognizers>
                                <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_1"/>
                            </yummy:PancakeView.GestureRecognizers>
                        </yummy:PancakeView>

                        <!-- Cancel Button -->
                        <Label Text="Cancel"
                             FontSize="15"
                             TextColor="#757575"
                             HorizontalTextAlignment="Center"
                             Margin="0,5,0,0">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOverlayTapped"/>
                            </Label.GestureRecognizers>
                        </Label>

                    </StackLayout>
                </ScrollView>

            </Grid>
        </yummy:PancakeView>
    </Grid>
</ContentPage>