<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             x:Class="YIRSHospital.Views.Staff.StaffDashboard"
             BackgroundColor="#F0F4F8"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <StackLayout Padding="20,24,20,32" Spacing="22">

            <!-- ── Elegant Header Card ─────────────────────────────── -->
            <yummy:PancakeView BackgroundColor="White"
                               CornerRadius="20"
                               Padding="20,18"
                               HasShadow="True"
                               Elevation="4">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <!-- Avatar circle -->
                    <yummy:PancakeView Grid.Column="0"
                                       WidthRequest="52" HeightRequest="52"
                                       CornerRadius="16"
                                       BackgroundColor="#E0F2FE"
                                       VerticalOptions="Center">
                        <Label Text="👤"
                               FontSize="24"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </yummy:PancakeView>

                    <!-- Greeting + Name -->
                    <StackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="{Binding Greeting}"
                               FontSize="13"
                               TextColor="#64748B"/>
                        <Label Text="{Binding StaffName}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#0F172A"
                               LineBreakMode="TailTruncation"/>
                    </StackLayout>

                    <!-- Settings gear (quick access) -->
                    <yummy:PancakeView Grid.Column="2"
                                       WidthRequest="40" HeightRequest="40"
                                       CornerRadius="12"
                                       BackgroundColor="#F1F5F9"
                                       VerticalOptions="Center"
                                       HorizontalOptions="End">
                        <Image Source="add" 
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                        <yummy:PancakeView.GestureRecognizers>
                            <TapGestureRecognizer Tapped="Settings_Tapped"/>
                        </yummy:PancakeView.GestureRecognizers>
                    </yummy:PancakeView>
                </Grid>
            </yummy:PancakeView>

            <!-- ── Section: Staff Services ─────────────────────────── -->
            <StackLayout Spacing="12">
                <Label Text="Staff Services"
                       FontSize="15"
                       FontAttributes="Bold"
                       TextColor="#0F172A"
                       Margin="4,0,0,0"/>

                <Grid ColumnDefinitions="*,*"
                      RowDefinitions="Auto,Auto"
                      RowSpacing="14"
                      ColumnSpacing="14">

                    <!-- Raise Bill -->
                    <yummy:PancakeView Grid.Row="0" Grid.Column="0"
                                       BackgroundColor="White"
                                       CornerRadius="18"
                                       Padding="16"
                                       HasShadow="True"
                                       Elevation="3">
                        <StackLayout Spacing="10">
                            <yummy:PancakeView WidthRequest="42" HeightRequest="42"
                                               CornerRadius="12"
                                               BackgroundColor="#DBEAFE"
                                               HorizontalOptions="Start">
                                <Image Source="add"  Margin="5"
            HorizontalOptions="Center"
            VerticalOptions="Center"/>
                            </yummy:PancakeView>
                            <StackLayout Spacing="2">
                                <Label Text="Raise Bill"
                                       FontAttributes="Bold"
                                       FontSize="15"
                                       TextColor="#0F172A"/>
                                <Label Text="Create new invoice"
                                       FontSize="12"
                                       TextColor="#64748B"/>
                            </StackLayout>
                        </StackLayout>
                        <yummy:PancakeView.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNavigateRaiseBill"/>
                        </yummy:PancakeView.GestureRecognizers>
                    </yummy:PancakeView>

                    <!-- Process Bill -->
                    <yummy:PancakeView Grid.Row="0" Grid.Column="1"
                                       BackgroundColor="White"
                                       CornerRadius="18"
                                       Padding="16"
                                       HasShadow="True"
                                       Elevation="3">
                        <StackLayout Spacing="10">
                            <yummy:PancakeView WidthRequest="42" HeightRequest="42"
                                               CornerRadius="12"
                                               BackgroundColor="#D1FAE5"
                                               HorizontalOptions="Start">
                                <Label Text="💳"
                                       FontSize="20"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </yummy:PancakeView>
                            <StackLayout Spacing="2">
                                <Label Text="Process Bill"
                                       FontAttributes="Bold"
                                       FontSize="15"
                                       TextColor="#0F172A"/>
                                <Label Text="Handle payments"
                                       FontSize="12"
                                       TextColor="#64748B"/>
                            </StackLayout>
                        </StackLayout>
                        <yummy:PancakeView.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNavigateProcessBill"/>
                        </yummy:PancakeView.GestureRecognizers>
                    </yummy:PancakeView>

                    <!-- Confirm Payment -->
                    <yummy:PancakeView Grid.Row="1" Grid.Column="0"
                                       BackgroundColor="White"
                                       CornerRadius="18"
                                       Padding="16"
                                       HasShadow="True"
                                       Elevation="3">
                        <StackLayout Spacing="10">
                            <yummy:PancakeView WidthRequest="42" HeightRequest="42"
                                               CornerRadius="12"
                                               BackgroundColor="#FEF3C7"
                                               HorizontalOptions="Start">
                                <Label Text="✅"
                                       FontSize="20"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </yummy:PancakeView>
                            <StackLayout Spacing="2">
                                <Label Text="Confirm Paid"
                                       FontAttributes="Bold"
                                       FontSize="15"
                                       TextColor="#0F172A"/>
                                <Label Text="Verify receipts"
                                       FontSize="12"
                                       TextColor="#64748B"/>
                            </StackLayout>
                        </StackLayout>
                        <yummy:PancakeView.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNavigateConfirmPayment"/>
                        </yummy:PancakeView.GestureRecognizers>
                    </yummy:PancakeView>

                    <!-- Patient History -->
                    <yummy:PancakeView Grid.Row="1" Grid.Column="1"
                                       BackgroundColor="White"
                                       CornerRadius="18"
                                       Padding="16"
                                       HasShadow="True"
                                       Elevation="3">
                        <StackLayout Spacing="10">
                            <yummy:PancakeView WidthRequest="42" HeightRequest="42"
                                               CornerRadius="12"
                                               BackgroundColor="#E0E7FF"
                                               HorizontalOptions="Start">
                                <Image Source="tenementlist"  Margin="5"
            HorizontalOptions="Center"
            VerticalOptions="Center"/>
                            </yummy:PancakeView>
                            <StackLayout Spacing="2">
                                <Label Text="Patient History"
                                       FontAttributes="Bold"
                                       FontSize="15"
                                       TextColor="#0F172A"/>
                                <Label Text="View records"
                                       FontSize="12"
                                       TextColor="#64748B"/>
                            </StackLayout>
                        </StackLayout>
                        <yummy:PancakeView.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNavigatePatientHistory"/>
                        </yummy:PancakeView.GestureRecognizers>
                    </yummy:PancakeView>
                </Grid>
            </StackLayout>

            <!-- ── Utility Actions ─────────────────────────────────── -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <!-- Test Print -->
                <yummy:PancakeView Grid.Column="0"
                                   BackgroundColor="White"
                                   CornerRadius="14"
                                   Padding="14,12"
                                   HasShadow="True"
                                   Elevation="2">
                    <StackLayout Orientation="Horizontal" Spacing="10" HorizontalOptions="Center">
                        <Image Source="print" VerticalOptions="Center" HeightRequest="20"/>
                        <Label Text="Test Print"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#334155"
                               VerticalOptions="Center"/>
                    </StackLayout>
                    <yummy:PancakeView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="TestPrinter_Tapped"/>
                    </yummy:PancakeView.GestureRecognizers>
                </yummy:PancakeView>

                <!-- Settings -->
                <yummy:PancakeView Grid.Column="1"
                                   BackgroundColor="White"
                                   CornerRadius="14"
                                   Padding="14,12"
                                   HasShadow="True"
                                   Elevation="2">
                    <StackLayout Orientation="Horizontal" Spacing="10" HorizontalOptions="Center">
                        <Label Text="⚙️" FontSize="16" VerticalOptions="Center"/>
                        <Label Text="Settings"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#334155"
                               VerticalOptions="Center"/>
                    </StackLayout>
                    <yummy:PancakeView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Settings_Tapped"/>
                    </yummy:PancakeView.GestureRecognizers>
                </yummy:PancakeView>
            </Grid>

            <!-- ── Recent Bills Section ────────────────────────────── -->
            <StackLayout Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="My Recent Raised Bills"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="#0F172A"
                           VerticalOptions="Center"/>
                    <Label Grid.Column="1"
                           Text="Last 7 days"
                           FontSize="12"
                           TextColor="#94A3B8"
                           VerticalOptions="Center"/>
                </Grid>

                <StackLayout x:Name="RecentBillsStack" BindableLayout.ItemsSource="{Binding RecentBills}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <yummy:PancakeView BackgroundColor="White" CornerRadius="12" Padding="14" Margin="0,0,0,8" HasShadow="True">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6">

                                    <Label Grid.Row="0" Grid.Column="0" Text="{Binding PatientName}" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
                                    <Label Grid.Row="1" Grid.Column="0" Text="{Binding DateRecorded}" FontSize="12" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>

                                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding Amount, StringFormat='₦{0:N2}'}" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource Primary}" HorizontalOptions="End" VerticalOptions="Center"/>

                                    <yummy:PancakeView Grid.Row="1" Grid.Column="1" BackgroundColor="{Binding StatusBgColor}" CornerRadius="6" Padding="8,4" HorizontalOptions="End" VerticalOptions="Center">
                                        <Label Text="{Binding Status}" TextColor="{Binding StatusColor}" FontSize="11" FontAttributes="Bold"/>
                                    </yummy:PancakeView>

                                </Grid>
                            </yummy:PancakeView>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                    <BindableLayout.EmptyView>
                        <StackLayout Padding="20">
                            <Label Text="No recent bills raised." TextColor="Gray" HorizontalOptions="Center"/>
                        </StackLayout>
                    </BindableLayout.EmptyView>
                </StackLayout>
            </StackLayout>

        </StackLayout>
    </ScrollView>
</ContentPage>