<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView" xmlns:renderers="clr-namespace:YIRSHospital.Services"
             x:Class="YIRSHospital.Views.RaisePatientBill"
             BackgroundColor="#F4F6F8"
             Title="Raise Patient Bill">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="Primary">#004225</Color>
            <Color x:Key="PrimaryLight">#006B3C</Color>
            <Color x:Key="Accent">#FF6B35</Color>
            <Color x:Key="TextPrimary">#1A202C</Color>
            <Color x:Key="TextSecondary">#718096</Color>
            <Color x:Key="Border">#E2E8F0</Color>

            <Style x:Key="FieldLabel" TargetType="Label">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
                <Setter Property="Margin" Value="2,0,0,6"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <StackLayout Spacing="16" Padding="16">

            <!-- Patient Information -->
            <yummy:PancakeView BackgroundColor="White" CornerRadius="14" Padding="16" HasShadow="True">
                <StackLayout Spacing="14">
                    <Label Text="Patient Information" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>

                    <StackLayout Spacing="4">
                        <Label Text="Patient Number" Style="{StaticResource FieldLabel}"/>
                        <yummy:PancakeView BorderColor="{StaticResource Border}" BorderThickness="1" CornerRadius="10" BackgroundColor="#F9FAFB" HeightRequest="48">
                            <renderers:BorderlessEntry x:Name="PatientNoEntry" Placeholder="Enter Patient No" Margin="12,0" FontSize="12" TextColor="{StaticResource TextPrimary}"/>
                        </yummy:PancakeView>
                    </StackLayout>

                    <StackLayout Spacing="4">
                        <Label Text="Additional Notes" Style="{StaticResource FieldLabel}"/>
                        <yummy:PancakeView BorderColor="{StaticResource Border}" BorderThickness="1" CornerRadius="10" BackgroundColor="#F9FAFB" HeightRequest="48">
                            <renderers:BorderlessEntry x:Name="NotesEntry" Placeholder="e.g., Urgent" FontSize="12" Margin="12,0" TextColor="{StaticResource TextPrimary}"/>
                        </yummy:PancakeView>
                    </StackLayout>
                </StackLayout>
            </yummy:PancakeView>

            <!-- Department & Services -->
            <yummy:PancakeView BackgroundColor="White" CornerRadius="14" Padding="16" HasShadow="True">
                <StackLayout Spacing="14">

                    <StackLayout Spacing="4">
                        <Label Text="Department" Style="{StaticResource FieldLabel}"/>
                        <yummy:PancakeView BorderColor="{StaticResource Border}" BorderThickness="1" CornerRadius="10" BackgroundColor="#F9FAFB" HeightRequest="48">
                            <Picker x:Name="DepartmentPicker"
                                    Title="Select Department"
                                    Margin="12,0"
                                    VerticalOptions="Center"
                                    ItemDisplayBinding="{Binding name}"
                                    SelectedIndexChanged="OnDepartmentSelectedIndexChanged"
                                    TextColor="{StaticResource TextPrimary}"/>
                        </yummy:PancakeView>
                    </StackLayout>

                    <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                        <Label Grid.Column="0" Text="Select Services" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
                        <Label Grid.Column="1" x:Name="TotalAmountLabel" Text="₦0.00" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Accent}" VerticalOptions="Center"/>
                    </Grid>
                    <CollectionView x:Name="ServicesList" HeightRequest="300" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,8" ColumnSpacing="12">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Color="#004225" CheckedChanged="OnServiceCheckedChanged"/>

                                    <!-- Explicit Dark Text Color Applied Here -->
                                    <Label Grid.Column="1" Text="{Binding serviceName}" FontSize="14" TextColor="#1A202C" VerticalOptions="Center"/>

                                    <!-- Explicit Accent Color Applied Here -->
                                    <Label Grid.Column="2" Text="{Binding amount, StringFormat='₦{0:N2}'}" FontSize="14" FontAttributes="Bold" TextColor="#FF6B35" VerticalOptions="Center"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <Label Text="Select a department to view services" TextColor="#718096" HorizontalOptions="Center" Margin="0,20,0,0"/>
                        </CollectionView.EmptyView>
                    </CollectionView>

                    <Button Text="RAISE BILL" BackgroundColor="{StaticResource Primary}" TextColor="White" FontAttributes="Bold" CornerRadius="10" HeightRequest="50" Clicked="OnRaiseBillClicked"/>
                </StackLayout>
            </yummy:PancakeView>

        </StackLayout>
    </ScrollView>
</ContentPage>