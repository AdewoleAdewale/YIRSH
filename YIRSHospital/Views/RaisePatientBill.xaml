<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:renderers="clr-namespace:YIRSHospital.Services"
             x:Class="YIRSHospital.Views.RaisePatientBill"
             BackgroundColor="#F4F6F8"
             Title="Raise Patient Bill">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="Primary">#004225</Color>
            <Color x:Key="PrimaryLight">#006B3C</Color>
            <Color x:Key="Accent">#FF6B35</Color>
            <Color x:Key="TextPrimary">#1A202C</Color>
            <Color x:Key="TextSecondary">#718096</Color>
            <Color x:Key="Border">#E2E8F0</Color>
            <Color x:Key="Success">#15803D</Color>
            <Color x:Key="Danger">#DC2626</Color>

            <Style x:Key="FieldLabel" TargetType="Label">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
                <Setter Property="Margin" Value="2,0,0,6"/>
            </Style>

            <Style x:Key="CardTitle" TargetType="Label">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
            </Style>

            <Style x:Key="InputShell" TargetType="yummy:PancakeView">
                <Setter Property="BorderColor" Value="{StaticResource Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="BackgroundColor" Value="#F9FAFB"/>
                <Setter Property="HeightRequest" Value="48"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- Root grid so the bottom sheet can overlay the page -->
    <Grid x:Name="RootGrid">

        <ScrollView>
            <StackLayout Spacing="16" Padding="16,16,16,28">

                <!-- Summary header -->
                <yummy:PancakeView CornerRadius="16" Padding="18" HasShadow="True">
                    <yummy:PancakeView.BackgroundGradientStops>
                        <yummy:GradientStopCollection>
                            <yummy:GradientStop Color="#004225" Offset="0"/>
                            <yummy:GradientStop Color="#006B3C" Offset="1"/>
                        </yummy:GradientStopCollection>
                    </yummy:PancakeView.BackgroundGradientStops>
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="2">
                        <Label Grid.Row="0" Grid.Column="0" Text="BILL TOTAL" FontSize="11"
                               TextColor="#B7D9C6" CharacterSpacing="1"/>
                        <Label Grid.Row="1" Grid.Column="0" x:Name="TotalAmountLabel" Text="₦0.00"
                               FontSize="30" FontAttributes="Bold" TextColor="White"/>
                        <Label Grid.Row="2" Grid.Column="0" x:Name="SelectionSummaryLabel"
                               Text="No service selected" FontSize="12" TextColor="#B7D9C6"/>

                        <yummy:PancakeView Grid.Row="0" Grid.RowSpan="3" Grid.Column="1"
                                           BackgroundColor="#1A5C3C" CornerRadius="12"
                                           Padding="12,8" VerticalOptions="Center">
                            <Label x:Name="HospitalCodeLabel" Text="—" FontSize="12"
                                   FontAttributes="Bold" TextColor="White" VerticalOptions="Center"/>
                        </yummy:PancakeView>
                    </Grid>
                </yummy:PancakeView>

                <!-- Patient Information -->
                <yummy:PancakeView BackgroundColor="White" CornerRadius="14" Padding="16" HasShadow="True">
                    <StackLayout Spacing="14">
                        <Label Text="Patient Information" Style="{StaticResource CardTitle}"/>

                        <StackLayout Spacing="4">
                            <Label Text="Patient Number" Style="{StaticResource FieldLabel}"/>
                            <yummy:PancakeView Style="{StaticResource InputShell}">
                                <renderers:BorderlessEntry x:Name="PatientNoEntry" Placeholder="Enter Patient No"
                                                           Margin="12,0" FontSize="12"
                                                           TextColor="{StaticResource TextPrimary}"/>
                            </yummy:PancakeView>
                        </StackLayout>

                        <StackLayout Spacing="4">
                            <Label Text="Additional Notes" Style="{StaticResource FieldLabel}"/>
                            <yummy:PancakeView Style="{StaticResource InputShell}">
                                <renderers:BorderlessEntry x:Name="NotesEntry" Placeholder="e.g., Urgent"
                                                           FontSize="12" Margin="12,0"
                                                           TextColor="{StaticResource TextPrimary}"/>
                            </yummy:PancakeView>
                        </StackLayout>
                    </StackLayout>
                </yummy:PancakeView>

                <!-- Department & Services -->
                <yummy:PancakeView BackgroundColor="White" CornerRadius="14" Padding="16" HasShadow="True">
                    <StackLayout Spacing="14">

                        <StackLayout Spacing="4">
                            <Label Text="Department" Style="{StaticResource FieldLabel}"/>
                            <yummy:PancakeView Style="{StaticResource InputShell}">
                                <Picker x:Name="DepartmentPicker"
                                        Title="Select Department"
                                        Margin="12,0"
                                        VerticalOptions="Center"
                                        ItemDisplayBinding="{Binding name}"
                                        SelectedIndexChanged="OnDepartmentSelectedIndexChanged"
                                        TextColor="{StaticResource TextPrimary}"/>
                            </yummy:PancakeView>
                        </StackLayout>

                        <!-- Search + select all -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <yummy:PancakeView Grid.Column="0" Style="{StaticResource InputShell}" HeightRequest="44">
                                <renderers:BorderlessEntry x:Name="ServiceSearchEntry"
                                                           Placeholder="Search services"
                                                           Margin="12,0" FontSize="12"
                                                           TextChanged="OnServiceSearchTextChanged"
                                                           TextColor="{StaticResource TextPrimary}"/>
                            </yummy:PancakeView>
                            <Button Grid.Column="1" x:Name="SelectAllButton" Text="Select all"
                                    FontSize="12" Padding="0" HeightRequest="44" WidthRequest="96"
                                    CornerRadius="10" BackgroundColor="#EAF2ED"
                                    TextColor="{StaticResource Primary}"
                                    Clicked="OnToggleSelectAllClicked"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                            <Label Grid.Column="0" Text="Select Services" Style="{StaticResource CardTitle}"
                                   VerticalOptions="Center"/>
                            <Label Grid.Column="1" x:Name="ServiceCountLabel" Text="0 selected"
                                   FontSize="12" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                        </Grid>

                        <CollectionView x:Name="ServicesList" HeightRequest="320" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <yummy:PancakeView Margin="0,5" CornerRadius="12" Padding="12,10"
                                                       BackgroundColor="#FBFCFD"
                                                       BorderColor="#E2E8F0" BorderThickness="1">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Color="#004225"
                                                      VerticalOptions="Center"
                                                      CheckedChanged="OnServiceCheckedChanged"/>

                                            <StackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                                <Label Text="{Binding ServiceName}" FontSize="14"
                                                       FontAttributes="Bold" TextColor="#1A202C"
                                                       LineBreakMode="TailTruncation"/>
                                                <Label Text="{Binding Description}" FontSize="11"
                                                       TextColor="#718096" LineBreakMode="TailTruncation"/>
                                            </StackLayout>

                                            <Label Grid.Column="2"
                                                   Text="{Binding Amount, StringFormat='₦{0:N2}'}"
                                                   FontSize="14" FontAttributes="Bold"
                                                   TextColor="#FF6B35" VerticalOptions="Center"/>
                                        </Grid>
                                    </yummy:PancakeView>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <StackLayout Padding="0,30" Spacing="6">
                                    <Label x:Name="EmptyStateLabel"
                                           Text="Select a department to view services"
                                           TextColor="#718096" FontSize="13" HorizontalOptions="Center"/>
                                </StackLayout>
                            </CollectionView.EmptyView>
                        </CollectionView>

                        <Button x:Name="RaiseBillButton" Text="RAISE BILL"
                                BackgroundColor="{StaticResource Primary}" TextColor="White"
                                FontAttributes="Bold" CornerRadius="10" HeightRequest="50"
                                Clicked="OnRaiseBillClicked"/>
                    </StackLayout>
                </yummy:PancakeView>

            </StackLayout>
        </ScrollView>

        <!-- ================= Result bottom sheet ================= -->
        <Grid x:Name="SheetOverlay" IsVisible="False" BackgroundColor="#00000000">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnSheetDismissTapped"/>
            </Grid.GestureRecognizers>

            <yummy:PancakeView x:Name="SheetContainer"
                               VerticalOptions="End"
                               BackgroundColor="White"
                               Padding="20,12,20,24" CornerRadius="10"
                               TranslationY="400">
              

                <StackLayout Spacing="14">
                    <BoxView HeightRequest="4" WidthRequest="44" CornerRadius="2"
                             Color="#E2E8F0" HorizontalOptions="Center"/>

                    <yummy:PancakeView x:Name="SheetIconShell" CornerRadius="30"
                                       HeightRequest="60" WidthRequest="60"
                                       BackgroundColor="#E7F5EC" HorizontalOptions="Center">
                        <Label x:Name="SheetIconLabel" Text="✓" FontSize="28" FontAttributes="Bold"
                               TextColor="{StaticResource Success}"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </yummy:PancakeView>

                    <Label x:Name="SheetTitleLabel" Text="Success" FontSize="18" FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}" HorizontalTextAlignment="Center"/>

                    <Label x:Name="SheetMessageLabel" Text="" FontSize="13"
                           TextColor="{StaticResource TextSecondary}"
                           HorizontalTextAlignment="Center"/>

                    <!-- Optional detail rows (bill breakdown) -->
                    <yummy:PancakeView x:Name="SheetDetailShell" IsVisible="False"
                                       CornerRadius="12" BackgroundColor="#F7F9FA" Padding="14,12">
                        <StackLayout x:Name="SheetDetailStack" Spacing="8"/>
                    </yummy:PancakeView>

                    <Button x:Name="SheetPrimaryButton" Text="DONE"
                            BackgroundColor="{StaticResource Primary}" TextColor="White"
                            FontAttributes="Bold" CornerRadius="10" HeightRequest="48"
                            Clicked="OnSheetPrimaryClicked"/>
                </StackLayout>
            </yummy:PancakeView>
        </Grid>
    </Grid>
</ContentPage>
